{
	"manifest_version": 2,
	"name": "AspaklaryaImages",
	"version": "2.0",
	"url": "https://www.mediawiki.org/wiki/Extension:AspaklaryaImages",
	"author": "[https://www.hamichlol.org.il/משתמש:מקוה מקוה]",
	"descriptionmsg": "aspaklaryaimages-desc",
	"license-name": "GPL-3.0-or-later",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.44.0"
	},
	"MessagesDirs": {
		"AspaklaryaImages": [
			"i18n"
		]
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\AspaklaryaImages\\": "includes/"
	},
	"GroupPermissions": {
		"*": {
			"aspaklaryaimages-show-unknown-images": true
		},
		"aspaklaryaEditor": {
			"aspaklaryaimages-manage-status": true,
			"aspaklaryaimages-view-status": true,
			"aspaklaryaimages-show-unknown-images": true,
			"aspaklaryaimages-show-blocked-images": true
		},
		"sysop": {
			"aspaklaryaimages-manage-status": true,
			"aspaklaryaimages-view-status": true,
			"aspaklaryaimages-show-unknown-images": true,
			"aspaklaryaimages-show-blocked-images": true
		},
		"spiritualCommittee": {
			"aspaklaryaimages-manage-status": true,
			"aspaklaryaimages-view-status": true,
			"aspaklaryaimages-show-unknown-images": true,
			"aspaklaryaimages-show-blocked-images": true
		},
		"imagesconfirmers": {
			"aspaklaryaimages-manage-status": true,
			"aspaklaryaimages-view-status": true,
			"aspaklaryaimages-show-unknown-images": true,
			"aspaklaryaimages-show-blocked-images": true
		}
	},
	"AvailableRights": [
		"aspaklaryaimages-manage-status",
		"aspaklaryaimages-view-status",
		"aspaklaryaimages-show-unknown-images",
		"aspaklaryaimages-show-blocked-images"
	],
	"Hooks": {
		"LoadExtensionSchemaUpdates": "schema",
		"ImageBeforeProduceHTML": "main",
		"AfterParserFetchFileAndTitle": "main",
		"GalleryGetModes": "main"
	},
	"HookHandlers": {
		"schema": {
			"class": "MediaWiki\\Extension\\AspaklaryaImages\\Hooks\\SchemaUpdater"
		},
		"main": {
			"class": "MediaWiki\\Extension\\AspaklaryaImages\\Hooks\\Main",
			"services": [
				"DBLoadBalancer",
				"MainWANObjectCache"
			]
		}
	},
	"LogTypes": [],
	"LogNames": {},
	"LogHeaders": {},
	"LogActionsHandlers": {},
	"LogRestrictions": {},
	"Actions": {},
	"APIModules": {
		"aspaklaryaimages-manage-status": "MediaWiki\\Extension\\AspaklaryaImages\\ApiAIStatusMannage"
	},
	"ExtensionMessagesFiles": {},
	"SpecialPages": {},
	"GrantPermissionGroups": {
		"aspaklaryaimages": "administration"
	},
	"GrantPermissions": {
		"aspaklaryaimages": {
			"aspaklaryaimages-manage-status": true,
			"aspaklaryaimages-view-status": true,
			"aspaklaryaimages-show-unknown-images": true,
			"aspaklaryaimages-show-blocked-images": true
		}
	},
	"config": {
		"BlockNetfreeUnknownImages": {
			"value": false,
			"description": "If true, images with unknown netfree status will be blocked for all users in server level. it also won't add any placeholder or indication that the image is blocked, including any tracking category."
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "resources",
		"remoteExtPath": "AspaklaryaImages/resources"
	},
	"ResourceModules": {
		"ext.aspaklaryaimages.styles": {
			"styles": "ext.aspaklaryaimages.css"
		}
	},
	"TrackingCategories": [
		"aspaklaryaimages-unauthorized-category",
		"aspaklaryaimages-netfree-unknown-category",
		"aspaklaryaimages-netfree-blocked-category"
	],
	"DefaultUserOptions": {
		"aspaklaryaimages-show-unknown": 1,
		"aspaklaryaimages-show-blocked": 0
	}
}